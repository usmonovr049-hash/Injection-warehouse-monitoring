# Generated by source/build_login.js each refresh run: per-run random salts/IVs
# make this file differ every build, so it isn't meant to be tracked here.
# The published output is source/quyish-open.html (source) -> index.html (deployed)
# and the Claude Artifact; quyish-login.html itself is a local build artifact.
source/quyish-login.html

# CI (GitHub Actions) ephemeral install, never commit:
source/ci/node_modules/
source/ci/package-lock.json
source/ci/__pycache__/
